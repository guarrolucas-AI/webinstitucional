# Google OAuth2 credentials used by actions/create-meeting.ts and actions/submit-lead.ts
# to write to the calendar owner's own "primary" calendar (meeting bookings +
# simulator leads). Personal OAuth, not a service account — org policy blocks
# service account key creation. See README for the one-time setup steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
