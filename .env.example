# Google OAuth2 credentials used by actions/create-meeting.ts and actions/submit-lead.ts
# to write to the calendar owner's own "primary" calendar (meeting bookings +
# simulator leads). Personal OAuth, not a service account — org policy blocks
# service account key creation. See README for the one-time setup steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Resend API key used by lib/notify-meeting.ts to email a notification for
# each new meeting booked through actions/create-meeting.ts. Get one at
# resend.com → API Keys.
RESEND_API_KEY=
# Address that receives the "new meeting booked" notification email.
MEETING_NOTIFICATION_EMAIL=
